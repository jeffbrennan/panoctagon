FROM python:3.12-slim AS python-deps
ENV UV_PYTHON_DOWNLOADS=never
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
WORKDIR /panoctagon
COPY pyproject.toml uv.lock readme.md ./
RUN uv sync --frozen --only-group web --no-install-project

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/panoctagon"
WORKDIR /panoctagon
COPY --from=python-deps /panoctagon/.venv ./.venv
COPY panoctagon/ ./panoctagon
EXPOSE 8000
ENTRYPOINT ["/panoctagon/.venv/bin/uvicorn", "panoctagon.api.server:app", "--host", "0.0.0.0", "--port", "8000", "--root-path", "/api"]
