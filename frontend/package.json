{
  "name": "panoctagon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write src e2e *.ts *.js *.json index.html"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
